generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          Int           @id @default(autoincrement())
  username    String        @unique
  password    String        @default("hashedpassword") // Added for Auth
  totalPoints Int           @default(0)
  theme       String        @default("all")
  rank        Int           @default(0)
  teams       FantasyTeam[]
}

model Player {
  id       Int      @id @default(autoincrement())
  name     String
  role     String
  cost     Int
  theme    String
  img      String
  points   Int      @default(0)
  
  // Relations
  teamMembers FantasyTeamMember[]
  logs        PerformanceLog[]
}

model FantasyTeam {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  theme     String   // 'f1', 'football', 'hackathon'
  budget    Int      @default(100)
  createdAt DateTime @default(now())

  members   FantasyTeamMember[]
}

model FantasyTeamMember {
  id            Int         @id @default(autoincrement())
  fantasyTeamId Int
  playerId      Int
  teamRole      String?     // 'C', 'VC', or null
  
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  player        Player      @relation(fields: [playerId], references: [id])
}

model Event {
  id       Int      @id @default(autoincrement())
  title    String
  type     String
  date     String
  teams    String
  theme    String
  status   String
}

model PerformanceLog {
  id          Int      @id @default(autoincrement())
  playerId    Int
  player      Player   @relation(fields: [playerId], references: [id])
  action      String
  pointsAdded Int
  notes       String?
  createdAt   DateTime @default(now())
}
